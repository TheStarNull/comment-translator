{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["acode-plugin-types"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../../src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
