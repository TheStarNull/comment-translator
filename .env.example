# DeepL API key (Free key ends with ":fx", Pro key does not)
# Get one at: https://www.deepl.com/pro-api
DEEPL_API_KEY=your_api_key_here:fx

# Force Free or Pro endpoint (auto-detected by :fx suffix if unset)
# DEEPL_FREE=true

# Default target language (ZH=简体中文, EN, JA, KO, DE, FR, ES, ...)
DEFAULT_TARGET_LANG=ZH
