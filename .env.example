# ============================================================
# DeepL (default backend: --backend deepl)
# ============================================================
# DeepL API key (Free key ends with ":fx", Pro key does not)
# Get one at: https://www.deepl.com/pro-api
DEEPL_API_KEY=your_api_key_here:fx

# Force Free or Pro endpoint (auto-detected by :fx suffix if unset)
# DEEPL_FREE=true

# ============================================================
# Google Translate (--backend google)
# ============================================================
# Option 1: a plain API key
# Get one at: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_google_api_key

# Option 2 (recommended for production): a service-account key.json
# GOOGLE_APPLICATION_CREDENTIALS=./google-key.json

# ============================================================
# Common
# ============================================================
# Default target language (ZH / zh-CN / EN / JA / KO / DE / FR / ES ...)
DEFAULT_TARGET_LANG=ZH
