{
  "name": "comment-translator",
  "version": "2.6.0",
  "description": "Translate JSDoc and code comments using DeepL / Google Translate API. Supports TS/JS/JSX.",
  "main": "dist/cli.js",
  "bin": {
    "comment-translator": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "test": "node dist/test-demo.js",
    "test:unit": "ts-node src/polisher.test.ts",
    "test:polish": "ts-node src/smoke-polish.ts",
    "test:terms": "ts-node src/term-protector.test.ts",
    "test:protection": "tsc && ts-node src/test-protection-default.ts",
    "test:timeout": "ts-node src/test-timeout.ts",
    "test:parser": "ts-node src/parser.test.ts",
    "test:mock": "tsc && ts-node src/mock-translator.test.ts",
    "test:jsdoc": "ts-node src/jsdoc-parser.test.ts",
    "test:cache": "ts-node src/test-cache-resume.ts"
  },
  "keywords": [
    "jsdoc",
    "translator",
    "deepl",
    "google-translate",
    "typescript",
    "comments"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "deepl-node": "^1.28.0",
    "dotenv": "^16.3.1"
  },
  "optionalDependencies": {
    "typescript": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
